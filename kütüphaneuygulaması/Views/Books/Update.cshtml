@model kütüphaneuygulaması.Models.Book
@{
    ViewData["Title"] = "Kitap Güncelle";
}

<h2 class="mb-4">Kitap Güncelle</h2>

<form method="post" action="/Books/Update">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="mb-3">
        <label class="form-label">Kitap Başlığı</label>
        <input type="text" class="form-control" name="Title" value="@Model.Title" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Yazar</label>
        <input type="text" class="form-control" name="Author" value="@Model.Author" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Fiyat (₺)</label>
        <input type="number" class="form-control" name="Price" value="@Model.Price" step="0.01" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Stok</label>
        <input type="number" class="form-control" name="Stock" value="@Model.Stock" required />
    </div>
    <button type="submit" class="btn btn-warning">Güncelle</button>
    <a href="/Books/Index" class="btn btn-secondary">İptal</a>
</form>